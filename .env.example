# SARA AI — Environment Variables Example Configuration
# Copy this file to .env and insert your API keys and endpoints.

# ============================================
# 1. LLM / Intelligence Layer (OpenAI Primary)
# ============================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
PRIMARY_LLM=openai

# Optional Fallback LLM (Groq for ultra-low latency)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# ============================================
# 2. Real-Time Speech-to-Text (Deepgram STT)
# ============================================
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_REGION=global
DEEPGRAM_MODEL=nova-2

# ============================================
# 3. Real-Time Text-to-Speech (Cartesia Sonic TTS)
# ============================================
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_MODEL_ID=sonic-2
DEFAULT_VOICE_ID=330c4fa0-1da3-4c55-8e97-951bfd724e20

# Optional Indic Voice Provider (Sarvam AI)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5

# ============================================
# 4. Telephony Provider (Plivo / Exotel India & Global)
# ============================================
PUBLIC_WS_URL=
PUBLIC_BASE_URL=
TELEPHONY_PROVIDER=plivo

# ============================================
# Plivo Telephony Configuration (India / Global)
# ============================================
PLIVO_AUTH_ID=your_plivo_auth_id_here
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here
PLIVO_PHONE_NUMBER=+918065522007
PLIVO_WEBHOOK_BASE_URL=http://localhost:8000
TELEPHONY_PROVIDER=plivo

# ============================================
# 5. Database & Server Configuration
# ============================================
DATABASE_URL=sqlite:///sara.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/sara_ai
REDIS_URL=redis://localhost:6379/0

HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5174

# ============================================
# 6. Authentication (Firebase / JWT)
# ============================================
JWT_SECRET=sara_super_secret_jwt_key_production_2026
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ============================================
# 7. Google Workspace OAuth
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/space/google/callback/
